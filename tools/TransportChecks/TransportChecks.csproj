<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);SYSLIB0014</NoWarn>
    <GameDir Condition="'$(CUPHEAD_PATH)' != ''">$(CUPHEAD_PATH)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">E:\SteamLibrary\steamapps\common\Cuphead</GameDir>
    <ManagedDir>$(GameDir)\Cuphead_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Compile Include="..\..\src\Coophead\InputFrame.cs" Link="InputFrame.cs" />
    <Compile Include="..\..\src\Coophead\Transport\IInputFrameTransport.cs" Link="IInputFrameTransport.cs" />
    <Compile Include="..\..\src\Coophead\Transport\InputFramePacketCodec.cs" Link="InputFramePacketCodec.cs" />
    <Compile Include="..\..\src\Coophead\Transport\LanControlPacketCodec.cs" Link="LanControlPacketCodec.cs" />
    <Compile Include="..\..\src\Coophead\Transport\LanScenePacketCodec.cs" Link="LanScenePacketCodec.cs" />
    <Compile Include="..\..\src\Coophead\Transport\SceneCommand.cs" Link="SceneCommand.cs" />
    <Compile Include="..\..\src\Coophead\Transport\LanSessionContextPacketCodec.cs" Link="LanSessionContextPacketCodec.cs" />
    <Compile Include="..\..\src\Coophead\Transport\SessionContext.cs" Link="SessionContext.cs" />
    <Compile Include="..\..\src\Coophead\Transport\PlayerStateSnapshot.cs" Link="PlayerStateSnapshot.cs" />
    <Compile Include="..\..\src\Coophead\Transport\LanPlayerStatePacketCodec.cs" Link="LanPlayerStatePacketCodec.cs" />
    <Compile Include="..\..\src\Coophead\Transport\BossStateSnapshot.cs" Link="BossStateSnapshot.cs" />
    <Compile Include="..\..\src\Coophead\Transport\LanBossStatePacketCodec.cs" Link="LanBossStatePacketCodec.cs" />
    <Compile Include="..\..\src\Coophead\Transport\LoopbackInputTransport.cs" Link="LoopbackInputTransport.cs" />
    <Compile Include="..\..\src\Coophead\Transport\UdpInputTransport.cs" Link="UdpInputTransport.cs" />
    <Compile Include="..\..\src\Coophead\Transport\RelayInputTransport.cs" Link="RelayInputTransport.cs" />
    <Compile Include="..\..\src\Coophead\Transport\StunPacketCodec.cs" Link="StunPacketCodec.cs" />
    <Compile Include="..\..\src\Coophead\Transport\P2pInputTransport.cs" Link="P2pInputTransport.cs" />
  </ItemGroup>
</Project>
